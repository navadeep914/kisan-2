   "source": [
    "monthly_season = df_clean.groupby(['month', 'season'])['modal_price'].mean().reset_index()\n",
    "month_names = {1:'Jan',2:'Feb',3:'Mar',4:'Apr',5:'May',6:'Jun',\n",
    "               7:'Jul',8:'Aug',9:'Sep',10:'Oct',11:'Nov',12:'Dec'}\n",
    "monthly_season['month_name'] = monthly_season['month'].map(month_names)\n",
    "\n",
    "season_colors = {'Winter':'#3498db','Spring':'#2ecc71','Summer':'#e74c3c','Kharif':'#e67e22','Rabi':'#9b59b6'}\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 5))\n",
    "\n",
    "# Monthly avg\n",
    "axes[0].bar(range(12),\n",
    "            [monthly_season[monthly_season['month']==m]['modal_price'].values[0]\n",
    "             if m in monthly_season['month'].values else 0 for m in range(1,13)],\n",
    "            color=[season_colors.get(monthly_season[monthly_season['month']==m]['season'].values[0],'grey')\n",
    "                   if m in monthly_season['month'].values else 'grey' for m in range(1,13)],\n",
    "            alpha=0.85, edgecolor='white')\n",
    "axes[0].set_xticks(range(12))\n",
    "axes[0].set_xticklabels(list(month_names.values()), rotation=30)\n",
