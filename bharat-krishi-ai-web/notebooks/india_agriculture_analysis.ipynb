    "---\n",
    "## Section 2 — Data Preprocessing"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q1–Q6. Missing values, duplicates, data quality"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('=== MISSING VALUES ===')\n",
    "missing = df.isnull().sum()\n",
    "print(missing[missing > 0] if missing.sum() > 0 else 'No missing values found ✓')\n",
    "\n",
    "print('\\n=== DUPLICATES ===')\n",
    "full_dups = df.duplicated().sum()\n",
    "key_dups  = df.duplicated(subset=['state','district','commodity','arrival_date']).sum()\n",
    "print(f'Full duplicate rows         : {full_dups}')\n",
    "print(f'Key-field duplicate records : {key_dups}')\n",
    "\n",
    "print('\\n=== PRICE SANITY CHECK ===')\n",
    "bad_prices = df[(df['min_price'] > df['max_price']) | (df['modal_price'] == 0)]\n",
    "print(f'Records where min > max     : {(df[\"min_price\"] > df[\"max_price\"]).sum()}')\n",
    "print(f'Records with zero modal_price: {(df[\"modal_price\"] == 0).sum()}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q7–Q12. Full preprocessing pipeline"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df_clean = df.copy()\n",
    "\n",
    "# 1. Standardize string columns\n",
    "for col in ['state', 'district', 'market', 'commodity', 'variety']:\n",
    "    df_clean[col] = df_clean[col].str.strip().str.title()\n",
    "print('✓ Standardized string columns to Title Case')\n",
    "\n",
    "# 2. Parse and extract date parts\n",
    "df_clean['arrival_date'] = pd.to_datetime(df_clean['arrival_date'], dayfirst=True, errors='coerce')\n",
    "df_clean['year']   = df_clean['arrival_date'].dt.year\n",
    "df_clean['month']  = df_clean['arrival_date'].dt.month\n",
    "df_clean['day']    = df_clean['arrival_date'].dt.day\n",
    "df_clean['season'] = df_clean['month'].map({\n",
    "    1:'Winter', 2:'Winter', 3:'Spring', 4:'Spring',\n",
    "    5:'Summer', 6:'Kharif', 7:'Kharif', 8:'Kharif',\n",
    "    9:'Kharif', 10:'Rabi', 11:'Rabi', 12:'Winter'\n",
    "})\n",
    "print('✓ Extracted year, month, day, season from arrival_date')\n",
    "\n",
    "# 3. Fix bad prices\n",
    "df_clean.loc[df_clean['min_price'] > df_clean['max_price'], 'min_price'] = \\\n",
    "    df_clean.loc[df_clean['min_price'] > df_clean['max_price'], 'max_price']\n",
    "df_clean = df_clean[df_clean['modal_price'] > 0]\n",
    "print('✓ Fixed inverted min/max prices, removed zero modal_price rows')\n",
    "\n",
    "# 4. Remove duplicates\n",
    "before = len(df_clean)\n",
    "df_clean.drop_duplicates(inplace=True)\n",
    "print(f'✓ Removed {before - len(df_clean)} duplicate rows')\n",
    "\n",
    "# 5. IQR-based outlier detection on modal_price\n",
    "Q1 = df_clean['modal_price'].quantile(0.25)\n",
    "Q3 = df_clean['modal_price'].quantile(0.75)\n",
    "IQR = Q3 - Q1\n",
    "outliers = ((df_clean['modal_price'] < Q1 - 3*IQR) | (df_clean['modal_price'] > Q3 + 3*IQR)).sum()\n",
    "print(f'✓ Outliers detected in modal_price (3×IQR): {outliers}')\n",
    "# Keep outliers but flag them\n",
    "df_clean['is_price_outlier'] = (\n",
    "    (df_clean['modal_price'] < Q1 - 3*IQR) | (df_clean['modal_price'] > Q3 + 3*IQR)\n",
    ").astype(int)\n",
    "\n",
    "# 6. Label encode categoricals\n",
    "le = {}\n",
    "for col in ['state', 'district', 'commodity', 'variety', 'season']:\n",
    "    le[col] = LabelEncoder()\n",
    "    df_clean[f'{col}_enc'] = le[col].fit_transform(df_clean[col])\n",
    "print('✓ Label encoded: state, district, commodity, variety, season')\n",
    "\n",
    "print(f'\\nFinal clean dataset shape: {df_clean.shape}')\n",
    "df_clean.head(3)"
   ]
  },
