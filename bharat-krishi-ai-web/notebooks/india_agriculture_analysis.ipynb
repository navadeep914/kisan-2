    "def smart_farming_advisor(farmer_query: dict) -> dict:\n",
    "    \"\"\"\n",
    "    Unified smart farming advisor integrating:\n",
    "    1. Market price prediction\n",
    "    2. Best commodity recommendation\n",
    "    3. Seasonal advisory\n",
    "    4. Region analysis\n",
    "    Placeholders for disease detection, soil, weather, and scheme modules.\n",
    "    \"\"\"\n",
    "    state  = farmer_query.get('state', 'Uttar Pradesh')\n",
    "    month  = farmer_query.get('month', 6)\n",
    "    year   = farmer_query.get('year', 2024)\n",
    "    budget = farmer_query.get('budget_crop', None)\n",
    "\n",
    "    season_map = {1:'Winter',2:'Winter',3:'Spring',4:'Spring',5:'Summer',\n",
    "                  6:'Kharif',7:'Kharif',8:'Kharif',9:'Kharif',10:'Rabi',11:'Rabi',12:'Winter'}\n",
    "    season = season_map[month]\n",
    "\n",
    "    # 1. Price predictions for top commodities in this state\n",
    "    state_commodities = (\n",
    "        df_clean[df_clean['state'].str.title() == state.title()]['commodity']\n",
    "        .value_counts().head(8).index.tolist()\n",
    "    )\n",
    "    price_forecasts = {}\n",
    "    for c in state_commodities:\n",
    "        price_forecasts[c] = predict_price(c, state, month, year)\n",
    "\n",
    "    sorted_forecasts = sorted(price_forecasts.items(), key=lambda x: x[1], reverse=True)\n",
    "\n",
    "    # 2. Seasonal advisory\n",
    "    seasonal_tips = {\n",
    "        'Kharif'  : 'Kharif season (Jun–Sep): Best for Paddy, Sugarcane, Cotton, Soybean.',\n",
    "        'Rabi'    : 'Rabi season (Oct–Mar): Best for Wheat, Mustard, Potato, Onion.',\n",
    "        'Summer'  : 'Summer (May): Suitable for Watermelon, Cucumber, Green Chilli.',\n",
    "        'Spring'  : 'Spring (Mar–Apr): Suitable for early vegetables.',\n",
    "        'Winter'  : 'Winter (Dec–Feb): Suitable for cold-season vegetables, Pea, Carrot.'\n",
    "    }\n",
    "\n",
    "    result = {\n",
    "        'state'              : state,\n",
    "        'season'             : season,\n",
    "        'top_price_forecasts': sorted_forecasts[:5],\n",
    "        'recommended_crop'   : sorted_forecasts[0][0] if sorted_forecasts else 'N/A',\n",
    "        'seasonal_advisory'  : seasonal_tips.get(season, ''),\n",
    "        'disease_module'     : 'Connect plant disease detection model for leaf image analysis.',\n",
    "        'soil_module'        : 'Connect soil analysis API for NPK-based crop recommendations.',\n",
    "        'weather_module'     : 'Connect IMD/OpenWeather API for rainfall and temperature forecasts.',\n",
    "        'scheme_module'      : 'Connect Government Schemes module for state-specific subsidies.'\n",
    "    }\n",
    "    return result\n",
    "\n",
    "# Demo\n",
    "query = {'state': 'Punjab', 'month': 10, 'year': 2024}\n",
    "advice = smart_farming_advisor(query)\n",
    "print('=== SMART FARMING ADVISOR ===')\n",
    "print(f'State    : {advice[\"state\"]}')\n",
    "print(f'Season   : {advice[\"season\"]}')\n",
    "print(f'Advisory : {advice[\"seasonal_advisory\"]}')\n",
    "print(f'\\nTop 5 Price Forecasts for {advice[\"state\"]} (Month {query[\"month\"]}, {query[\"year\"]}):')\n",
    "for i, (crop, price) in enumerate(advice['top_price_forecasts'], 1):\n",
    "    print(f'  {i}. {crop:<25} ₹{price:,.0f}/quintal')\n",
    "print(f'\\nRecommended crop: {advice[\"recommended_crop\"]}')\n",
    "print(f'\\nIntegration placeholders:')\n",
    "for k in ['disease_module','soil_module','weather_module','scheme_module']:\n",
    "    print(f'  [{k}] {advice[k]}')"
