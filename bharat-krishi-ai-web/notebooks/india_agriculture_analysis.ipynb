  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q6 & Q11. Production/price trends over time"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Monthly average price trend\n",
    "monthly = df_clean.groupby(df_clean['arrival_date'].dt.to_period('M'))['modal_price'].mean().reset_index()\n",
    "monthly['arrival_date'] = monthly['arrival_date'].dt.to_timestamp()\n",
    "\n",
    "fig, axes = plt.subplots(2, 1, figsize=(14, 9))\n",
    "\n",
    "# Overall price trend\n",
    "axes[0].plot(monthly['arrival_date'], monthly['modal_price'], color='#2980b9', linewidth=2)\n",
    "axes[0].fill_between(monthly['arrival_date'], monthly['modal_price'], alpha=0.2, color='#2980b9')\n",
    "axes[0].set_title('Monthly Average Modal Price Trend (₹/quintal)', fontweight='bold')\n",
    "axes[0].set_ylabel('Avg Modal Price ₹')\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Top 5 commodity price trends\n",
    "top5_comm = df_clean['commodity'].value_counts().head(5).index.tolist()\n",
    "colors5 = ['#e74c3c','#2ecc71','#9b59b6','#e67e22','#1abc9c']\n",
    "for comm, color in zip(top5_comm, colors5):\n",
    "    subset = df_clean[df_clean['commodity'] == comm]\n",
    "    trend  = subset.groupby(subset['arrival_date'].dt.to_period('M'))['modal_price'].mean().reset_index()\n",
    "    trend['arrival_date'] = trend['arrival_date'].dt.to_timestamp()\n",
    "    axes[1].plot(trend['arrival_date'], trend['modal_price'], label=comm, color=color, linewidth=1.5)\n",
    "\n",
    "axes[1].set_title('Price Trends — Top 5 Commodities', fontweight='bold')\n",
    "axes[1].set_ylabel('Avg Modal Price ₹')\n",
    "axes[1].legend(fontsize=9); axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('price_trends.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q8 & Q9. Price spread analysis (min–max gap as proxy for volatility)"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df_clean['price_spread']  = df_clean['max_price'] - df_clean['min_price']\n",
    "df_clean['price_cv']      = (df_clean['price_spread'] / df_clean['modal_price'] * 100).round(2)  # Coefficient of variation\n",
    "\n",
    "volatility = df_clean.groupby('commodity').agg(\n",
    "    avg_spread   = ('price_spread', 'mean'),\n",
    "    avg_cv       = ('price_cv', 'mean'),\n",
    "    avg_price    = ('modal_price', 'mean')\n",
    ").round(1).sort_values('avg_cv', ascending=False)\n",
    "\n",
    "print('Top 10 most price-volatile commodities (high CV%):')\n",
    "print(volatility.head(10).to_string())\n",
    "print('\\nTop 10 most stable commodities (low CV%):')\n",
    "print(volatility.tail(10).to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q12–Q13. Regional productivity hotspots and area-production relationship"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# State × Commodity price heatmap\n",
    "top10_comm = df_clean['commodity'].value_counts().head(10).index\n",
    "top10_states = df_clean['state'].value_counts().head(10).index\n",
    "\n",
    "pivot = df_clean[\n",
    "    (df_clean['commodity'].isin(top10_comm)) &\n",
    "    (df_clean['state'].isin(top10_states))\n",
    "].pivot_table(index='state', columns='commodity', values='modal_price', aggfunc='mean').round(0)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 7))\n",
    "sns.heatmap(pivot, annot=True, fmt='.0f', cmap='YlOrRd',\n",
    "            linewidths=0.5, linecolor='white', ax=ax,\n",
    "            cbar_kws={'label': 'Avg Modal Price ₹/quintal'})\n",
    "ax.set_title('State × Commodity Average Price Heatmap (₹/quintal)', fontsize=13, fontweight='bold')\n",
    "plt.xticks(rotation=45, ha='right', fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.savefig('state_commodity_heatmap.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
