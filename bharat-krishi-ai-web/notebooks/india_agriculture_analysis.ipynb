    "    print(f'{name:<18} | CV MAE: {-neg_mae.mean():.1f} ± {neg_mae.std():.1f} | CV R²: {r2_cv.mean():.4f} ± {r2_cv.std():.4f}')\n",
    "\n",
    "print('\\n=== COMPLETE MODEL SCORECARD ===')\n",
