    "## Section 11 — Agricultural Intelligence System"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q1–Q8. Crop price prediction + high-productivity region detection"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "best_ml_model = results[best_model_name]['model']\n",
    "\n",
    "def predict_price(commodity_name, state_name, month, year):\n",
    "    \"\"\"\n",
    "    Predict modal price for a commodity in a given state and month.\n",
    "\n",
    "    Parameters:\n",
    "        commodity_name : str — commodity to predict price for\n",
    "        state_name     : str — state name\n",
    "        month          : int — month (1–12)\n",
    "        year           : int — year\n",
    "\n",
    "    Returns:\n",
    "        Predicted modal price in ₹/quintal\n",
    "    \"\"\"\n",
    "    # Encode inputs (use -1 for unseen labels)\n",
    "    def safe_encode(encoder, value):\n",
    "        try:\n",
    "            return encoder.transform([value.title()])[0]\n",
    "        except:\n",
    "            return 0\n",
    "\n",
    "    comm_enc   = safe_encode(le['commodity'], commodity_name)\n",
    "    state_enc  = safe_encode(le['state'], state_name)\n",
    "    season_map = {1:'Winter',2:'Winter',3:'Spring',4:'Spring',5:'Summer',\n",
    "                  6:'Kharif',7:'Kharif',8:'Kharif',9:'Kharif',10:'Rabi',11:'Rabi',12:'Winter'}\n",
    "    season_enc = safe_encode(le['season'], season_map[month])\n",
    "\n",
    "    # Use dataset medians for unknown rolling stats\n",
    "    hist_avg = df_clean[df_clean['commodity'].str.title() == commodity_name.title()]['modal_price'].mean()\n",
    "    hist_avg = hist_avg if not np.isnan(hist_avg) else df_clean['modal_price'].median()\n",
    "\n",
    "    row = pd.DataFrame([{\n",
    "        'commodity_enc'          : comm_enc,\n",
    "        'state_enc'              : state_enc,\n",
    "        'variety_enc'            : 0,\n",
    "        'season_enc'             : season_enc,\n",
    "        'month'                  : month,\n",
    "        'quarter'                : (month - 1) // 3 + 1,\n",
    "        'year'                   : year,\n",
    "        'week_of_year'           : month * 4,\n",
    "        'day_of_week'            : 1,\n",
    "        'min_price'              : hist_avg * 0.9,\n",
    "        'max_price'              : hist_avg * 1.1,\n",
    "        'price_spread'           : hist_avg * 0.2,\n",
    "        'price_range_ratio'      : 0.2,\n",
    "        'comm_rolling_avg_3m'    : hist_avg,\n",
    "        'comm_rolling_std_3m'    : hist_avg * 0.1,\n",
    "        'price_vs_state_comm_avg': 0\n",
    "    }])\n",
    "\n",
    "    pred = best_ml_model.predict(row[ml_features])[0]\n",
    "    return round(pred, 2)\n",
    "\n",
    "# Demo predictions\n",
    "demo_queries = [\n",
    "    ('Potato',  'Uttar Pradesh', 3, 2024),\n",
    "    ('Tomato',  'Maharashtra',   6, 2024),\n",
    "    ('Onion',   'Gujarat',       10, 2024),\n",
    "    ('Banana',  'Kerala',        1, 2024),\n",
    "    ('Brinjal', 'Tamil Nadu',    8, 2024),\n",
    "]\n",
    "print('=== PRICE PREDICTIONS ===')\n",
    "print(f'{\"Commodity\":<20} {\"State\":<20} {\"Month\":<8} {\"Year\":<6} {\"Predicted ₹/qtl\":>16}')\n",
    "print('-' * 75)\n",
    "for comm, state, month, year in demo_queries:\n",
    "    pred = predict_price(comm, state, month, year)\n",
    "    print(f'{comm:<20} {state:<20} {month:<8} {year:<6} {pred:>16,.0f}')"
   ]
