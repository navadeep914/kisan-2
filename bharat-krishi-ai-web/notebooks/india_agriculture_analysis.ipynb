  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Section 7 — Time Series Forecasting"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q1–Q4. Stationarity test and decomposition"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build a monthly time series for the most common commodity\n",
    "top_commodity = df_clean['commodity'].value_counts().idxmax()\n",
    "ts_df = df_clean[df_clean['commodity'] == top_commodity].copy()\n",
    "ts_monthly = ts_df.set_index('arrival_date')['modal_price'].resample('M').mean().dropna()\n",
    "\n",
    "print(f'Time series built for: {top_commodity}')\n",
    "print(f'Period: {ts_monthly.index[0].date()} to {ts_monthly.index[-1].date()}')\n",
    "print(f'Points: {len(ts_monthly)}')\n",
    "\n",
    "# ADF stationarity test\n",
    "adf_result = adfuller(ts_monthly)\n",
    "print(f'\\nADF Statistic  : {adf_result[0]:.4f}')\n",
    "print(f'p-value        : {adf_result[1]:.4f}')\n",
    "print(f'Stationary     : {\"Yes ✓\" if adf_result[1] < 0.05 else \"No — differencing needed\"}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Seasonal decomposition\n",
    "if len(ts_monthly) >= 24:\n",
    "    decomp = seasonal_decompose(ts_monthly, model='additive', period=12)\n",
    "\n",
    "    fig, axes = plt.subplots(4, 1, figsize=(14, 12))\n",
    "    for ax, data, title in zip(\n",
    "        axes,\n",
    "        [ts_monthly, decomp.trend, decomp.seasonal, decomp.resid],\n",
    "        ['Original', 'Trend', 'Seasonality', 'Residual']\n",
    "    ):\n",
    "        ax.plot(data, color='#2980b9' if title != 'Residual' else '#e74c3c', linewidth=1.5)\n",
    "        ax.set_title(title, fontweight='bold')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "    plt.suptitle(f'Seasonal Decomposition — {top_commodity} Monthly Prices', fontsize=13, fontweight='bold')\n",
    "    plt.tight_layout()\n",
    "    plt.savefig('seasonal_decomposition.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()\nelse:\n",
    "    print(f'Only {len(ts_monthly)} months — need ≥24 for decomposition. Building from overall price series instead.')\n",
    "    overall_monthly = df_clean.set_index('arrival_date')['modal_price'].resample('M').mean().dropna()\n",
    "    decomp = seasonal_decompose(overall_monthly, model='additive', period=min(12, len(overall_monthly)//2))\n",
    "    ts_monthly = overall_monthly"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q5. SARIMA forecasting"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "train_size = int(len(ts_monthly) * 0.8)\n",
    "train_ts   = ts_monthly[:train_size]\n",
    "test_ts    = ts_monthly[train_size:]\n",
    "\n",
    "print(f'Training points  : {len(train_ts)}')\n",
    "print(f'Testing points   : {len(test_ts)}')\n",
    "\n",
    "try:\n",
    "    sarima = SARIMAX(train_ts, order=(1,1,1),\n",
    "                     seasonal_order=(1,1,1,12),\n",
    "                     enforce_stationarity=False,\n",
    "                     enforce_invertibility=False)\n",
    "    sarima_fit = sarima.fit(disp=False)\n",
    "\n",
    "    # Forecast for test period + 6 months ahead\n",
    "    forecast_steps = len(test_ts) + 6\n",
    "    forecast = sarima_fit.get_forecast(steps=forecast_steps)\n",
    "    forecast_mean = forecast.predicted_mean\n",
    "    conf_int      = forecast.conf_int()\n",
    "\n",
    "    # Evaluate on test\n",
    "    if len(test_ts) > 0:\n",
    "        test_preds = forecast_mean[:len(test_ts)]\n",
    "        sarima_mae  = mean_absolute_error(test_ts, test_preds)\n",
    "        sarima_rmse = np.sqrt(mean_squared_error(test_ts, test_preds))\n",
    "        print(f'SARIMA Test MAE  : {sarima_mae:.1f}')\n",
    "        print(f'SARIMA Test RMSE : {sarima_rmse:.1f}')\n",
    "\n",
    "    # Plot\n",
    "    fig, ax = plt.subplots(figsize=(14, 6))\n",
    "    ax.plot(train_ts.index, train_ts.values, label='Train', color='#3498db', linewidth=1.5)\n",
    "    if len(test_ts) > 0:\n",
    "        ax.plot(test_ts.index, test_ts.values, label='Actual', color='#2ecc71', linewidth=1.5)\n",
    "    ax.plot(forecast_mean.index, forecast_mean.values, label='Forecast', color='#e74c3c', linewidth=1.5, linestyle='--')\n",
    "    ax.fill_between(conf_int.index, conf_int.iloc[:,0], conf_int.iloc[:,1], alpha=0.2, color='#e74c3c')\n",
    "    ax.set_title(f'SARIMA Forecast — {top_commodity} Monthly Price', fontweight='bold')\n",
    "    ax.set_ylabel('Price ₹/quintal')\n",
    "    ax.legend(); ax.grid(True, alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig('sarima_forecast.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()\nexcept Exception as e:\n",
    "    print(f'SARIMA error: {e}. Increase dataset size or adjust order parameters.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q5. Prophet forecasting"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "try:\n",
    "    from prophet import Prophet\n",
    "\n",
    "    prophet_df = ts_monthly.reset_index()\n",
    "    prophet_df.columns = ['ds', 'y']\n",
    "    prophet_df['ds'] = prophet_df['ds'].dt.tz_localize(None)\n",
    "\n",
    "    m = Prophet(yearly_seasonality=True, weekly_seasonality=False,\n",
    "                daily_seasonality=False, interval_width=0.95)\n",
    "    m.fit(prophet_df)\n",
    "\n",
    "    future   = m.make_future_dataframe(periods=12, freq='M')\n",
    "    forecast = m.predict(future)\n",
    "\n",
    "    fig = m.plot(forecast)\n",
    "    plt.title(f'Prophet Forecast — {top_commodity} Price (12-month ahead)', fontweight='bold')\n",
    "    plt.tight_layout()\n",
    "    plt.savefig('prophet_forecast.png', dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "    fig2 = m.plot_components(forecast)\n",
    "    plt.suptitle('Prophet Components (Trend + Seasonality)', fontweight='bold')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\nexcept ImportError:\n",
    "    print('Prophet not installed. Run: pip install prophet')\nexcept Exception as e:\n",
    "    print(f'Prophet error: {e}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Section 8 — Deep Learning (LSTM / GRU)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["### Q1–Q8. LSTM and GRU for sequential price forecasting"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare sequence data\n",
    "price_series = ts_monthly.values.reshape(-1, 1)\n",
    "\n",
    "scaler_ts = MinMaxScaler()\n",
    "price_scaled = scaler_ts.fit_transform(price_series)\n",
    "\n",
    "def create_sequences(data, window=6):\n",
    "    X, y = [], []\n",
    "    for i in range(len(data) - window):\n",
    "        X.append(data[i:i+window, 0])\n",
    "        y.append(data[i+window, 0])\n",
    "    return np.array(X), np.array(y)\n",
    "\n",
    "WINDOW = 6  # Use 6 months to predict next month\n",
    "X_seq, y_seq = create_sequences(price_scaled, WINDOW)\n",
    "X_seq = X_seq.reshape(X_seq.shape[0], X_seq.shape[1], 1)\n",
    "\n",
    "split = int(len(X_seq) * 0.8)\n",
    "X_tr, X_te = X_seq[:split], X_seq[split:]\n",
    "y_tr, y_te = y_seq[:split], y_seq[split:]\n",
    "\n",
    "print(f'Sequence window : {WINDOW} months')\n",
    "print(f'Train sequences : {len(X_tr)}')\n",
    "print(f'Test sequences  : {len(X_te)}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_lstm(window, units=64, dropout=0.2):\n",
    "    model = keras.Sequential([\n",
    "        keras.Input(shape=(window, 1)),\n",
    "        layers.LSTM(units, return_sequences=True),\n",
    "        layers.Dropout(dropout),\n",
    "        layers.LSTM(units // 2),\n",
    "        layers.Dropout(dropout),\n",
    "        layers.Dense(32, activation='relu'),\n",
    "        layers.Dense(1)\n",
    "    ], name='LSTM_PriceForecaster')\n",
    "    return model\n",
    "\n",
    "def build_gru(window, units=64, dropout=0.2):\n",
    "    model = keras.Sequential([\n",
    "        keras.Input(shape=(window, 1)),\n",
    "        layers.GRU(units, return_sequences=True),\n",
    "        layers.Dropout(dropout),\n",
    "        layers.GRU(units // 2),\n",
    "        layers.Dropout(dropout),\n",
    "        layers.Dense(32, activation='relu'),\n",
    "        layers.Dense(1)\n",
    "    ], name='GRU_PriceForecaster')\n",
    "    return model\n",
    "\n",
    "lstm_model = build_lstm(WINDOW)\n",
    "gru_model  = build_gru(WINDOW)\n",
    "\n",
    "for m in [lstm_model, gru_model]:\n",
    "    m.compile(optimizer=keras.optimizers.Adam(1e-3), loss='mse', metrics=['mae'])\n",
    "\n",
    "lstm_model.summary()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "callbacks_dl = [\n",
    "    keras.callbacks.EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True),\n",
    "    keras.callbacks.ReduceLROnPlateau(monitor='val_loss', factor=0.5, patience=5)\n",
    "]\n",
    "\n",
    "print('Training LSTM...')\n",
    "lstm_hist = lstm_model.fit(X_tr, y_tr, epochs=100, batch_size=8,\n",
    "                            validation_split=0.2, callbacks=callbacks_dl, verbose=0)\n",
    "print(f'LSTM trained in {len(lstm_hist.history[\"loss\"])} epochs')\n",
    "\n",
    "print('\\nTraining GRU...')\n",
    "gru_hist = gru_model.fit(X_tr, y_tr, epochs=100, batch_size=8,\n",
    "                          validation_split=0.2, callbacks=callbacks_dl, verbose=0)\n",
    "print(f'GRU trained in {len(gru_hist.history[\"loss\"])} epochs')\n",
    "\n",
    "# Evaluate\n",
    "dl_results = {}\n",
    "for name, model in [('LSTM', lstm_model), ('GRU', gru_model)]:\n",
    "    if len(X_te) > 0:\n",
    "        preds_sc = model.predict(X_te, verbose=0)\n",
    "        preds = scaler_ts.inverse_transform(preds_sc.reshape(-1,1)).flatten()\n",
    "        actuals = scaler_ts.inverse_transform(y_te.reshape(-1,1)).flatten()\n",
    "        mae  = mean_absolute_error(actuals, preds)\n",
    "        rmse = np.sqrt(mean_squared_error(actuals, preds))\n",
    "        r2   = r2_score(actuals, preds)\n",
    "        dl_results[name] = {'MAE': mae, 'RMSE': rmse, 'R2': r2, 'preds': preds, 'actuals': actuals}\n",
    "        print(f'{name} | MAE: {mae:.1f} | RMSE: {rmse:.1f} | R²: {r2:.4f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(16, 5))\n",
    "\n",
    "# Training curves\n",
    "for name, hist, color in [('LSTM', lstm_hist, '#3498db'), ('GRU', gru_hist, '#e74c3c')]:\n",
    "    epochs = range(1, len(hist.history['loss'])+1)\n",
    "    axes[0].plot(epochs, hist.history['loss'],     label=f'{name} train', color=color, linewidth=1.5)\n",
    "    axes[0].plot(epochs, hist.history['val_loss'], label=f'{name} val',   color=color, linestyle='--')\n",
    "axes[0].set_title('LSTM vs GRU — Training Loss', fontweight='bold')\n",
    "axes[0].set_xlabel('Epoch'); axes[0].set_ylabel('MSE')\n",
    "axes[0].legend(); axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Forecast comparison\n",
    "if dl_results:\n",
    "    actuals = dl_results['LSTM']['actuals']\n",
    "    axes[1].plot(actuals, label='Actual', color='#2ecc71', linewidth=2)\n",
    "    for name, color in [('LSTM','#3498db'), ('GRU','#e74c3c')]:\n",
    "        if name in dl_results:\n",
    "            axes[1].plot(dl_results[name]['preds'], label=f'{name} Pred',\n",
    "                         color=color, linewidth=1.5, linestyle='--')\n",
    "    axes[1].set_title('LSTM vs GRU — Test Predictions', fontweight='bold')\n",
    "    axes[1].set_xlabel('Time step'); axes[1].set_ylabel('Price ₹/quintal')\n",
    "    axes[1].legend(); axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.suptitle(f'Deep Learning Forecasting — {top_commodity}', fontsize=13, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.savefig('lstm_gru_forecast.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
