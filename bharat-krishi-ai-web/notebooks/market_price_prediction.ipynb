    "print(f'Q3  — Total unique commodities   : {df[\"Commodity\"].nunique()}')\n",
    "print(f'      Commodities: {sorted(df[\"Commodity\"].unique())}')\n",
    "\n",
    "# Q4 — States and mandis\n",
    "print(f'\\nQ4  — States : {df[\"State\"].nunique()}')\n",
    "print(f'      Markets: {df[\"Market\"].nunique()}')\n",
    "\n",
    "# Q5 — Attributes\n",
