    "\n",
    "import joblib\n",
    "sns.set_theme(style='whitegrid', palette='viridis')\n",
    "print('✅ All libraries imported!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["---\n## 📂 Section 2 — Data Collection Questions (Q1–Q10)"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# -------------------------------------------------------\n",
    "# OPTION A: Load your downloaded Kaggle CSV directly\n",
    "# df = pd.read_csv('your_market_prices.csv')\n",
    "# -------------------------------------------------------\n",
    "# OPTION B: Realistic Indian Mandi price dataset\n",
    "# Matches Agmarknet / Kaggle dataset structure exactly\n",
    "# -------------------------------------------------------\n",
    "\n",
    "np.random.seed(42)\n",
    "\n",
    "states = ['Andhra Pradesh','Telangana','Maharashtra','Karnataka','Punjab',\n",
    "          'Uttar Pradesh','Madhya Pradesh','Rajasthan','Gujarat','Tamil Nadu',\n",
    "          'West Bengal','Bihar','Haryana','Odisha','Kerala']\n",
    "\n",
    "commodities_prices = {\n",
    "    'Rice':         (1800, 3200), 'Wheat':        (1500, 2800),\n",
    "    'Maize':        (1200, 2200), 'Onion':         (500, 4500),\n",
    "    'Tomato':        (300, 5000), 'Potato':        (600, 2500),\n",
    "    'Soybean':      (3000, 5500), 'Cotton':        (5000, 8500),\n",
    "    'Sugarcane':     (250,  450), 'Groundnut':     (4000, 7000),\n",
    "    'Turmeric':     (5000,12000), 'Chilli':        (4000,15000),\n",
    "    'Jowar':        (1500, 2800), 'Bajra':         (1400, 2500),\n",
    "    'Arhar Dal':    (5000, 9000), 'Moong Dal':     (6000,10000),\n",
    "    'Urad Dal':     (5500, 9500), 'Mustard':       (4000, 6500),\n",
    "    'Sunflower':    (3500, 5500), 'Garlic':        (2000, 8000)\n",
    "}\n",
    "\n",
    "varieties   = ['Local','Hybrid','Grade A','Grade B','Premium','Standard','Fine','Bold']\n",
    "grades      = ['FAQ','Grade A','Grade B','Grade C','Premium','Local']\n",
    "date_range  = pd.date_range(start='2018-01-01', end='2024-12-31', freq='D')\n",
    "\n",
    "records = []\n",
    "for _ in range(25000):\n",
    "    state     = np.random.choice(states)\n",
    "    commodity = np.random.choice(list(commodities_prices.keys()))\n",
    "    date      = np.random.choice(date_range)\n",
    "    p_low, p_high = commodities_prices[commodity]\n",
    "\n",
    "    # Seasonal price effect\n",
    "    season_factor = 1.0\n",
    "    month = date.month\n",
    "    if commodity in ['Onion','Tomato','Potato']:\n",
    "        season_factor = 1.4 if month in [5,6,7] else (0.8 if month in [11,12,1] else 1.0)\n",
    "    elif commodity in ['Rice','Wheat']:\n",
    "        season_factor = 0.85 if month in [10,11,4,5] else 1.1\n",
    "\n",
    "    modal = int(np.random.uniform(p_low, p_high) * season_factor)\n",
    "    min_p = int(modal * np.random.uniform(0.85, 0.97))\n",
    "    max_p = int(modal * np.random.uniform(1.03, 1.18))\n",
    "    arrivals = int(np.random.uniform(50, 5000))\n",
    "\n",
    "    records.append({\n",
    "        'State'        : state,\n",
    "        'District'     : f'{state[:4]}_District_{np.random.randint(1,6)}',\n",
    "        'Market'       : f'{state[:4]}_Mandi_{np.random.randint(1,8)}',\n",
    "        'Commodity'    : commodity,\n",
    "        'Variety'      : np.random.choice(varieties),\n",
    "        'Grade'        : np.random.choice(grades),\n",
    "        'Arrival_Date' : date,\n",
    "        'Arrivals_Qty' : arrivals,\n",
    "        'Min_Price'    : min_p,\n",
    "        'Max_Price'    : max_p,\n",
    "        'Modal_Price'  : modal\n",
    "    })\n",
    "\n",
    "df = pd.DataFrame(records).sort_values('Arrival_Date').reset_index(drop=True)\n",
    "print(f'✅ Dataset created: {df.shape[0]:,} rows × {df.shape[1]} columns')\n",
    "df.head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q1 — Dataset info\n",
    "print('Q1 — Dataset Overview:')\n",
