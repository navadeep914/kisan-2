   "metadata": {},
   "outputs": [],
   "source": [
    "# Q7 — Numerical vs Categorical\n",
    "num_cols = df.select_dtypes(include=np.number).columns.tolist()\n",
    "cat_cols = df.select_dtypes(include='object').columns.tolist()\n",
    "print(f'Q7 — Numerical  : {num_cols}')\n",
    "print(f'     Categorical: {cat_cols}')\n",
    "\n",
    "# Q8 — Most frequent commodity\n",
    "print(f'\\nQ8 — Most frequent commodity: {df[\"Commodity\"].value_counts().idxmax()}')\n",
    "print(df['Commodity'].value_counts())\n",
    "\n",
    "# Q9 & Q10\n",
    "print('\\nQ9  — Useful columns: Commodity, State, Market, Variety, Grade, Month, Year, Arrivals_Qty → Modal_Price')\n",
