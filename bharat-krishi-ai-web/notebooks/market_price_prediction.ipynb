   "cell_type": "markdown",
   "metadata": {},
   "source": ["---\n## 🎯 Section 11 — Market Price Prediction Function"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "xgb_final = XGBRegressor(n_estimators=200, learning_rate=0.05, random_state=42, verbosity=0)\n",
    "xgb_final.fit(X_train, y_train)\n",
    "\n",
    "BEST_SELL_MONTHS = {\n",
    "    'Onion':'May-June (price peak)', 'Tomato':'May-July (peak demand)',\n",
    "    'Chilli':'March-April (post-harvest premium)', 'Turmeric':'Feb-March (festival demand)',\n",
    "    'Cotton':'Jan-Feb (mill demand)', 'Groundnut':'Nov-Dec (festival season)',\n",
    "    'Rice':'June-July (lean season)', 'Wheat':'May-June (lean season)',\n",
    "}\n",
    "\n",
    "def predict_market_price(commodity, state, month, year, arrivals_qty,\n",
    "                          variety='Local', grade='FAQ', season=None):\n",
    "    \"\"\"\n",
    "    Predict modal market price for a given commodity, location, and date.\n",
    "    \"\"\"\n",
    "    if season is None:\n",
    "        season = get_season(month)\n",
    "    try: comm_enc   = le_commodity.transform([commodity.strip()])[0]\n",
    "    except: comm_enc = 0\n",
    "    try: state_enc  = le_state.transform([state.strip()])[0]\n",
    "    except: state_enc = 0\n",
    "    try: var_enc    = le_variety.transform([variety.strip()])[0]\n",
    "    except: var_enc = 0\n",
    "    try: grade_enc  = le_grade.transform([grade.strip()])[0]\n",
    "    except: grade_enc = 0\n",
    "    try: season_enc = le_season.transform([season.strip()])[0]\n",
    "    except: season_enc = 0\n",
    "\n",
    "    market_enc   = 0\n",
    "    quarter      = (month - 1) // 3 + 1\n",
    "    day_of_year  = (pd.Timestamp(year=year, month=month, day=15)).dayofyear\n",
    "    arr_cat      = 0 if arrivals_qty < 500 else (1 if arrivals_qty < 2000 else 2)\n",
    "    state_avg    = state_avg.get(state, state_avg.mean()) if isinstance(state_avg, pd.Series) else df.groupby('State')['Modal_Price'].mean().get(state, df['Modal_Price'].mean())\n",
    "    month_sin    = np.sin(2 * np.pi * month / 12)\n",
    "    month_cos    = np.cos(2 * np.pi * month / 12)\n",
    "\n",
    "    # Proxy lag and MA from historical data\n",
    "    hist = df[(df['Commodity']==commodity) & (df['Month']==month)]['Modal_Price']\n",
    "    ma7 = hist.mean() if len(hist) > 0 else df['Modal_Price'].mean()\n",
    "    ma30 = ma7\n",
    "    lag1 = ma7\n",
    "    lag7 = ma7\n",
    "    price_chg = 0.0\n",
    "\n",
    "    inp = np.array([[\n",
    "        comm_enc, state_enc, market_enc, var_enc, grade_enc, season_enc,\n",
    "        year, month, quarter, day_of_year,\n",
    "        np.log1p(arrivals_qty), arr_cat,\n",
    "        ma7, ma30, lag1, lag7, price_chg,\n",
    "        state_avg, month_sin, month_cos\n",
    "    ]])\n",
    "\n",
    "    log_pred = xgb_final.predict(inp)[0]\n",
    "    price_pred = np.expm1(log_pred)\n",
    "\n",
    "    # Profit advice\n",
    "    best_time = BEST_SELL_MONTHS.get(commodity, 'Check local mandi trends')\n",
    "    if month in [5,6,7]:\n",
    "        advice = '📈 Summer lean season — prices typically higher. Good time to sell.'\n",
    "    elif month in [10,11]:\n",
    "        advice = '📉 Harvest season — supply high, prices may be lower. Consider storage.'\n",
    "    else:\n",
    "        advice = '📊 Normal market conditions. Monitor mandi prices before selling.'\n",
    "\n",
    "    print('=' * 60)\n",
    "    print('   💹 MARKET PRICE PREDICTION RESULT')\n",
    "    print('=' * 60)\n",
    "    print(f'  Commodity : {commodity}  |  Variety: {variety}  |  Grade: {grade}')\n",
    "    print(f'  State     : {state}')\n",
    "    print(f'  Date      : Month {month}, {year}  |  Season: {season}')\n",
    "    print(f'  Arrivals  : {arrivals_qty} quintals')\n",
    "    print('-' * 60)\n",
    "    print(f'  ✅ Predicted Modal Price : ₹{price_pred:,.0f} / quintal')\n",
    "    print(f'  📊 Best Selling Period   : {best_time}')\n",
    "    print(f'  🧑‍🌾 Market Advice        : {advice}')\n",
    "    print('=' * 60)\n",
    "    return price_pred"
   ]
