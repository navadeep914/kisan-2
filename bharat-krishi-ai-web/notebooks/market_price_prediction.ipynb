   "source": ["---\n## 🔧 Section 6 — Feature Engineering Questions (Q1–Q8)"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q1–Q8 — All feature engineering\n",
    "\n",
    "# Q4 — Arrival quantity categories\n",
    "df['Arrival_Cat'] = pd.cut(df['Arrivals_Qty'],\n",
    "    bins=[0,500,2000,99999], labels=['Low','Medium','High'])\n",
    "df['Arrival_Cat_Enc'] = LabelEncoder().fit_transform(df['Arrival_Cat'].astype(str))\n",
    "\n",
    "# Q5 — Moving averages (per commodity)\n",
    "df_sorted = df.sort_values(['Commodity','Arrival_Date']).copy()\n",
    "df_sorted['MA_7']    = df_sorted.groupby('Commodity')['Modal_Price'].transform(lambda x: x.rolling(7,  min_periods=1).mean())\n",
    "df_sorted['MA_30']   = df_sorted.groupby('Commodity')['Modal_Price'].transform(lambda x: x.rolling(30, min_periods=1).mean())\n",
    "df_sorted['Price_Lag1'] = df_sorted.groupby('Commodity')['Modal_Price'].shift(1)\n",
    "df_sorted['Price_Lag7'] = df_sorted.groupby('Commodity')['Modal_Price'].shift(7)\n",
    "df_sorted['Price_Change_Pct'] = df_sorted.groupby('Commodity')['Modal_Price'].pct_change().fillna(0) * 100\n",
    "df_sorted.fillna(method='bfill', inplace=True)\n",
    "df = df_sorted.copy()\n",
    "\n",
    "# Q6 — State avg price (target encoding)\n",
    "state_avg = df.groupby('State')['Modal_Price'].mean()\n",
    "df['State_Avg_Price'] = df['State'].map(state_avg)\n",
    "\n",
    "# Q7 — Log price\n",
    "df['Log_Modal_Price']  = np.log1p(df['Modal_Price'])\n",
    "df['Log_Arrivals']     = np.log1p(df['Arrivals_Qty'])\n",
    "\n",
    "# Cyclical month encoding\n",
    "df['Month_Sin'] = np.sin(2 * np.pi * df['Month'] / 12)\n",
    "df['Month_Cos'] = np.cos(2 * np.pi * df['Month'] / 12)\n",
    "\n",
    "print('✅ Feature Engineering Complete!')\n",
    "eng_feats = ['Arrival_Cat_Enc','MA_7','MA_30','Price_Lag1','Price_Lag7',\n",
    "             'Price_Change_Pct','State_Avg_Price','Log_Modal_Price',\n",
    "             'Log_Arrivals','Month_Sin','Month_Cos']\n",
    "for f in eng_feats:\n",
    "    print(f'  ✔ {f}')"
   ]
