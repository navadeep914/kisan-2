   "source": ["---\n## 🧹 Section 3 — Data Preprocessing Questions (Q1–Q12)"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q1 & Q2 — Missing values\n",
    "missing = df.isnull().sum()\n",
    "print('Q1 & Q2 — Missing values:')\n",
    "print(missing[missing>0] if missing.sum()>0 else '✅ No missing values!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q3 — Imputation\n",
    "for col in df.select_dtypes(include=np.number).columns:\n",
    "    df[col].fillna(df[col].median(), inplace=True)\n",
    "for col in df.select_dtypes(include='object').columns:\n",
    "    df[col].fillna(df[col].mode()[0], inplace=True)\n",
    "print('Q3 — Imputation applied. Remaining:', df.isnull().sum().sum())\n",
    "\n",
    "# Q4, Q5, Q6 — Duplicates\n",
    "dupes = df.duplicated().sum()\n",
    "print(f'Q4 — Duplicates: {dupes > 0}  |  Q5 — Count: {dupes}')\n",
    "if dupes > 0:\n",
    "    df.drop_duplicates(inplace=True)\n",
    "    df.reset_index(drop=True, inplace=True)\n",
    "print(f'Q6 — Shape after check: {df.shape}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q7 & Q8 — Date parsing and feature extraction\n",
    "df['Arrival_Date'] = pd.to_datetime(df['Arrival_Date'])\n",
    "df['Year']         = df['Arrival_Date'].dt.year\n",
    "df['Month']        = df['Arrival_Date'].dt.month\n",
    "df['Day']          = df['Arrival_Date'].dt.day\n",
    "df['Quarter']      = df['Arrival_Date'].dt.quarter\n",
    "df['DayOfYear']    = df['Arrival_Date'].dt.dayofyear\n",
    "df['WeekOfYear']   = df['Arrival_Date'].dt.isocalendar().week.astype(int)\n",
    "\n",
    "def get_season(m):\n",
    "    if m in [3,4,5]:   return 'Spring'\n",
    "    elif m in [6,7,8]: return 'Summer'\n",
    "    elif m in [9,10,11]:return 'Autumn'\n",
    "    else:              return 'Winter'\n",
    "\n",
    "df['Season'] = df['Month'].apply(get_season)\n",
    "print('Q7 — Date parsed ✅')\n",
    "print('Q8 — Features extracted: Year, Month, Day, Quarter, DayOfYear, Season')\n",
    "df[['Arrival_Date','Year','Month','Quarter','Season']].head(3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Q9 — Encode categoricals\n",
    "for col in ['State','Market','Commodity','Variety','Grade','Season','District']:\n",
    "    df[col] = df[col].str.strip()\n",
    "\n",
    "le_state     = LabelEncoder()\n",
    "le_market    = LabelEncoder()\n",
    "le_commodity = LabelEncoder()\n",
    "le_variety   = LabelEncoder()\n",
    "le_grade     = LabelEncoder()\n",
    "le_season    = LabelEncoder()\n",
    "\n",
    "df['State_Enc']     = le_state.fit_transform(df['State'])\n",
    "df['Market_Enc']    = le_market.fit_transform(df['Market'])\n",
    "df['Commodity_Enc'] = le_commodity.fit_transform(df['Commodity'])\n",
    "df['Variety_Enc']   = le_variety.fit_transform(df['Variety'])\n",
    "df['Grade_Enc']     = le_grade.fit_transform(df['Grade'])\n",
    "df['Season_Enc']    = le_season.fit_transform(df['Season'])\n",
    "\n",
    "print('Q9  — Encoding complete ✅')\n",
    "print('Q10 — StandardScaler will be applied before SVR/ANN training.')\n",
    "print('Q11 — State/market/commodity names stripped ✅')\n",
    "print(f'Q12 — Clean dataset shape: {df.shape}')"
   ]
  },
